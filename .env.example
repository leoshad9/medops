# Used by: docker compose -f docker-compose.yml -f docker-compose.prod.yml --env-file .env up -d --build

HOST_HTTP_PORT=80
HOST_HTTPS_PORT=443

POSTGRES_DB=medops
POSTGRES_USER=medops
POSTGRES_PASSWORD=change-me-strong-password

# Must be a long random secret. Generate with: openssl rand -hex 32
JWT_SECRET=change-me-generate-with-openssl-rand-hex-32
# Access 15 minutes; refresh 8 hours.
JWT_ACCESS_EXPIRY_MS=900000
JWT_REFRESH_EXPIRY_MS=28800000

# LLM — dialect is the HTTP API shape, not a vendor name
#   generate_content  → POST /models/{model}:generateContent
#   chat_completions  → POST /chat/completions
LLM_PROVIDER=generate_content
LLM_API_KEY=
LLM_MODEL=
LLM_BASE_URL=

# Enable MedOps AI features
MEDOPS_AI_ENABLED=true

# Enable public patient/doctor self-registration
MEDOPS_SECURITY_OPEN_REGISTRATION=true
