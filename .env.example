    # Docker
    HOST_HTTP_PORT=80
    HOST_HTTPS_PORT=443
    # PostgreSQL host port; keep 5432 unless it is already in use
    LOCAL_DB_PORT=5432

    # PostgreSQL
    POSTGRES_DB=medops
    POSTGRES_USER=medops
    POSTGRES_PASSWORD=change-me-strong-password

    # JWT
    JWT_SECRET=change-me-generate-with-openssl-rand-hex-32
    JWT_ACCESS_EXPIRY_MS=900000
    JWT_REFRESH_EXPIRY_MS=28800000
    JWT_ISSUER=medops-api
    JWT_AUDIENCE=medops-web

    # LLM
    LLM_PROVIDER=generate_content
    LLM_API_KEY=
    LLM_MODEL=
    LLM_BASE_URL=

    # Features
    MEDOPS_AI_ENABLED=true
    MEDOPS_MESSAGING_ENABLED=false
    MEDOPS_REDIS_ENABLED=false

    # Clinic time zone (IANA) used for "today" bucketing and date presentation
    MEDOPS_CLINIC_TIMEZONE=Asia/Kolkata

    # Security
    MEDOPS_SECURITY_OPEN_REGISTRATION=true

    # SMTP (password-reset emails)
    MAIL_HOST=smtp.gmail.com
    MAIL_PORT=587
    MAIL_USERNAME=
    MAIL_PASSWORD=
    MAIL_FROM=

    # HMAC secret for hashing password-reset OTPs in Redis (generate: openssl rand -base64 32)
    PASSWORD_RESET_OTP_HMAC_SECRET=

    # Memory (2 GB t4g.small) — keep Java heaps bounded so the stack fits in RAM
    MEDOPS_API_JAVA_OPTS=-Xms128m -Xmx512m
    KAFKA_HEAP_OPTS=-Xms256m -Xmx512m

    # Observability (docker-compose.observability.yml). Grafana and Prometheus
    # bind to 127.0.0.1 only; reach them through an SSH tunnel.
    #   ssh -L 3000:127.0.0.1:3000 -L 9090:127.0.0.1:9090 ec2-user@<host>
    # GRAFANA_PASSWORD has no default on purpose: an unset value leaves the
    # admin account on admin/admin, and compose refuses to start rather than
    # silently shipping a published credential.
    GRAFANA_ADMIN_USER=admin
    GRAFANA_PASSWORD=change-me-strong-password
    LOCAL_GRAFANA_PORT=3000
    LOCAL_PROMETHEUS_PORT=9090
    # Series retention on disk. Unbounded retention is the usual way this fills
    # the EC2 volume.
    PROMETHEUS_RETENTION=15d
    # Label attached to Prometheus metrics, for telling local from prod apart.
    MEDOPS_ENV=local

    # Prometheus remote_write to Grafana Cloud
    PROMETHEUS_REMOTE_WRITE_URL=
    PROMETHEUS_REMOTE_WRITE_USER=
    PROMETHEUS_REMOTE_WRITE_PASSWORD=

    # Dynatrace via OpenTelemetry (docker-compose.observability.yml --profile otel).
    # DT_API_TOKEN and DT_TOKEN are different credentials. DT_API_TOKEN comes from
    # Dynatrace > Administration > Access tokens with the "Ingest traces" scope;
    # DT_TOKEN comes from Deployment > OneAgent > Code Agent and belongs to the
    # alternative oneagent profile below. DT_ENDPOINT is the OTLP HTTP ingest URL,
    # not the web console URL in DT_ENVIRONMENT_URL.
    DT_ENDPOINT=https://{environment-id}.live.dynatrace.com/api/v2/otlp
    DT_API_TOKEN=

    # Dynatrace OneAgent sidecar. Leave DT_TOKEN empty and no telemetry leaves the
    # host; the profile also has to be enabled explicitly. Only needed if you
    # choose OneAgent over OpenTelemetry.
    DT_TOKEN=
    DT_CONNECTION_URL=
    # Public host of your Dynatrace environment, e.g. ABCD1234.apps.dynatrace.com
    DT_ENVIRONMENT_URL=
